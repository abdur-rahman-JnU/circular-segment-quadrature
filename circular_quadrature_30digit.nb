                    RowBox[{"[", "i", "]"}], "]"}], "/", 
                    RowBox[{"Abs", "[", "exact", "]"}]}], ",", "0"}], "]"}], 
                   ",", "6"}], "]"}], ",", "4"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "methodValues", "]"}]}], "}"}]}], "]"}],
            ",", 
