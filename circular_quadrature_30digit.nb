            RowBox[{
            "\"\<Method\>\"", ",", "\"\<Computed Value\>\"", ",", 
             "\"\<Absolute Error\>\"", ",", "\"\<Relative Error\>\""}], 
            "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"resultsTable", "=", 
         RowBox[{"Insert", "[", 
          RowBox[{"resultsTable", ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Exact Reference Integral (30-digit)\>\"", ",", 
             RowBox[{"NumberForm", "[", 
